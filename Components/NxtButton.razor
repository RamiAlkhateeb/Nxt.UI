@namespace Nxt.UI.Components

<button class="nxt-button nxt-button-@Variant @CssClass" type="@Type" disabled="@(Disabled || Busy)" @onclick="OnClick" @attributes="AdditionalAttributes">
    @if (Busy) { <NxtSpinner Small="true" /> }
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    /// <summary>primary | secondary | ghost | danger | accent</summary>
    [Parameter] public string Variant { get; set; } = "primary";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
