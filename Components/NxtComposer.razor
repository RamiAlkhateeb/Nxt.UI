@namespace Nxt.UI.Components
@inject NxtText L
@inject INxtLocale Locale
@inject IJSRuntime JS
@implements IAsyncDisposable

@* The family's chat-style input: a pill with an auto-growing text area, a dictation button
   (mic → stop while recording) and a send button. Used by AiChat and by app quick-entry boxes,
   so every app types and talks to its assistant the same way. Position it with CssClass. *@
<div class="nxt-composer @(isListening ? "is-listening" : "") @CssClass" dir="@Locale.Direction">
    <textarea class="nxt-composer-input" dir="auto" rows="@Rows"
              value="@Value" @oninput="HandleInput" @onkeydown="HandleKeyDown"
              placeholder="@(isListening ? L["listening"] : Placeholder ?? L["ai_placeholder"])"
              aria-label="@(Placeholder ?? L["ai_placeholder"])"></textarea>
    @if (ShowMic && speechSupported)
    {
        <button type="button" class="nxt-composer-mic @(isListening ? "listening" : "")" @onclick="ToggleMicAsync"
                title="@(isListening ? L["mic_stop"] : L["ai_mic"])" aria-label="@(isListening ? L["mic_stop"] : L["ai_mic"])" aria-pressed="@isListening">
            @if (isListening)
            {
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2" fill="currentColor" stroke="none"/></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/></svg>
            }
        </button>
    }
    <button type="button" class="nxt-composer-send" @onclick="SubmitAsync"
            disabled="@(string.IsNullOrWhiteSpace(Value) || Disabled)"
            title="@(SendLabel ?? L["ai_send"])" aria-label="@(SendLabel ?? L["ai_send"])">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
    </button>
</div>
@if (!string.IsNullOrWhiteSpace(micError))
{
    <p class="nxt-composer-error" role="status" dir="@Locale.Direction">@micError</p>
}

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>Called with the trimmed text when the user sends (button, or Enter without Shift).</summary>
    [Parameter] public EventCallback<string> OnSubmit { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? SendLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowMic { get; set; } = true;
    /// <summary>BCP-47 tag for dictation, e.g. "ar-SA". Defaults to the UI language.</summary>
    [Parameter] public string? SpeechLanguage { get; set; }
    [Parameter] public string CssClass { get; set; } = "";

    private bool speechSupported;
    private bool isListening;
    private string textBeforeDictation = "";
    private string? micError;
    private DotNetObjectReference<NxtComposer>? selfRef;

    private int Rows => Math.Clamp((Value ?? "").Split('\n').Length, 1, 5);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !ShowMic) return;
        speechSupported = await JS.InvokeAsync<bool>("nxt.speech.isSupported");
        if (speechSupported) StateHasChanged();
    }

    private Task HandleInput(ChangeEventArgs e) => SetValueAsync(e.Value?.ToString() ?? "");

    private async Task SetValueAsync(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Enter sends on desktop; Shift+Enter keeps a newline.
        if (e.Key == "Enter" && !e.ShiftKey && !e.IsComposing)
            await SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        var text = (Value ?? "").Trim();
        if (text.Length == 0 || Disabled) return;
        if (isListening) await StopMicAsync();
        await OnSubmit.InvokeAsync(text);
    }

    private async Task ToggleMicAsync()
    {
        micError = null;
        if (isListening) { await StopMicAsync(); return; }
        selfRef ??= DotNetObjectReference.Create(this);
        textBeforeDictation = string.IsNullOrWhiteSpace(Value) ? "" : Value.TrimEnd() + " ";
        var lang = SpeechLanguage ?? (Locale.Language switch { "ar" => "ar-SA", "de" => "de-DE", _ => "en-US" });
        isListening = await JS.InvokeAsync<bool>("nxt.speech.start", selfRef, lang);
        if (!isListening) micError = L["mic_failed"];
    }

    private async Task StopMicAsync()
    {
        isListening = false;
        await JS.InvokeVoidAsync("nxt.speech.stop");
    }

    [JSInvokable]
    public async Task OnSpeechResult(string transcript)
    {
        await SetValueAsync(textBeforeDictation + transcript.Trim());
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSpeechError(string reason)
    {
        if (reason is "not-allowed" or "service-not-allowed") micError = L["mic_denied"];
        else if (reason is not ("no-speech" or "aborted")) micError = L["mic_failed"];
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSpeechEnded()
    {
        isListening = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (isListening)
        {
            try { await JS.InvokeVoidAsync("nxt.speech.stop"); } catch (JSDisconnectedException) { }
        }
        selfRef?.Dispose();
    }
}
