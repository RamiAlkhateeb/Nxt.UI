@namespace Nxt.UI.Components

@* A settings row with a label and an on/off switch. The whole row is the hit target. *@
<label class="nxt-switch-row @CssClass">
    <span class="nxt-switch-text">
        <span>@Label</span>
        @if (!string.IsNullOrWhiteSpace(Description)) { <small>@Description</small> }
    </span>
    <input type="checkbox" role="switch" class="nxt-switch" checked="@Value" disabled="@Disabled" @onchange="Toggle" />
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string CssClass { get; set; } = "";

    private Task Toggle(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value is bool b && b);
}
