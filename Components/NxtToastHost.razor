@namespace Nxt.UI.Components
@inject ToastService Toasts
@inject INxtLocale Locale
@implements IDisposable

@* Place once in the app layout. *@
@if (Toasts.Current is { } toast)
{
    @* @key restarts the enter animation when a newer toast replaces the visible one. *@
    <div @key="toast.Id" class="nxt-toast @(toast.IsError ? "is-error" : "") @(toast.Action is null ? "" : "has-action")" role="status" aria-live="polite" dir="@Locale.Direction" @onclick="Toasts.Hide">
        <span>@toast.Text</span>
        @if (toast.Action is not null)
        {
            <button type="button" class="nxt-toast-action" @onclick="Toasts.RunActionAsync" @onclick:stopPropagation="true">@toast.ActionLabel</button>
        }
    </div>
}

@code {
    protected override void OnInitialized() => Toasts.Changed += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Toasts.Changed -= Refresh;
}
