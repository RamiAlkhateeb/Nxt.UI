@namespace Nxt.UI.Settings
@using Nxt.UI.Ai
@inject AiSettingsService AiSettings
@inject GeminiClient Gemini
@inject ToastService Toasts
@inject NxtText L

@* The key saves when the field is left and the model as soon as it is picked, like every other setting.
   The Save button stays for anyone who looks for it. *@
<NxtSettingsSection Icon="✨" Title="@L["ai_title"]" Description="@L["ai_desc"]">
    <label class="nxt-label" for="nxt-ai-key">@L["ai_key_label"]</label>
    <input id="nxt-ai-key" class="nxt-input" type="password" dir="ltr" autocomplete="off" spellcheck="false"
           @bind="apiKey" @bind:event="oninput" @onchange="KeyChangedAsync" placeholder="@L["ai_key_placeholder"]" />
    <a class="nxt-link" href="https://aistudio.google.com/apikey" target="_blank" rel="noopener noreferrer">@L["ai_key_link"]</a>

    <label class="nxt-label" for="nxt-ai-model">@L["ai_model_label"]</label>
    <div class="nxt-input-row">
        <select id="nxt-ai-model" class="nxt-input" dir="ltr" @bind="model" @bind:after="ModelChangedAsync">
            @if (!models.Contains(model, StringComparer.OrdinalIgnoreCase))
            {
                <option value="@model">@model</option>
            }
            @foreach (var m in models)
            {
                <option value="@m">@m</option>
            }
        </select>
        <NxtIconButton Label="@L["ai_refresh_models"]" OnClick="RefreshModelsAsync" Disabled="isRefreshing">
            <svg class="@(isRefreshing ? "nxt-spin" : "")" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg>
        </NxtIconButton>
    </div>
    @if (modelsFailed)
    {
        <p class="nxt-hint is-error" role="status">@L["ai_no_models"]</p>
    }

    <NxtButton Variant="primary" OnClick="SaveAsync" Busy="isSaving">@L["ai_save"]</NxtButton>
</NxtSettingsSection>

@code {
    private string apiKey = "";
    private string savedKey = "";
    private string model = AiSettingsService.DefaultModel;
    private List<string> models = new();
    private bool isRefreshing;
    private bool isSaving;
    private bool modelsFailed;

    protected override async Task OnInitializedAsync()
    {
        apiKey = savedKey = await AiSettings.GetApiKeyAsync() ?? "";
        model = await AiSettings.GetModelAsync();
        // Uses the list already read this session, so opening Settings costs no request.
        if (!string.IsNullOrWhiteSpace(apiKey)) await LoadModelsAsync(refresh: false);
    }

    private async Task LoadModelsAsync(bool refresh)
    {
        models = await Gemini.ListModelsAsync(refresh);
        modelsFailed = !string.IsNullOrWhiteSpace(apiKey) && models.Count == 0;
    }

    private async Task KeyChangedAsync()
    {
        if (apiKey.Trim() == savedKey) return;
        await AiSettings.SaveApiKeyAsync(apiKey);
        savedKey = apiKey.Trim();
        Toasts.Show(L["ai_saved"]);
        if (!string.IsNullOrWhiteSpace(apiKey)) await LoadModelsAsync(refresh: true);
        else { models = new(); modelsFailed = false; }
    }

    private async Task ModelChangedAsync()
    {
        await AiSettings.SaveModelAsync(model);
        Toasts.Show(L.T("ai_model_saved", model));
    }

    private async Task RefreshModelsAsync()
    {
        isRefreshing = true;
        try
        {
            // Use the key currently typed, even if it hasn't been saved yet.
            await AiSettings.SaveApiKeyAsync(apiKey);
            savedKey = apiKey.Trim();
            await LoadModelsAsync(refresh: true);
            if (models.Count == 0) Toasts.Show(L["ai_no_models"], isError: true);
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        try
        {
            var keyChanged = apiKey.Trim() != savedKey;
            await AiSettings.SaveApiKeyAsync(apiKey);
            savedKey = apiKey.Trim();
            await AiSettings.SaveModelAsync(model);
            Toasts.Show(L["ai_saved"]);
            if (!string.IsNullOrWhiteSpace(apiKey) && (keyChanged || models.Count == 0)) await LoadModelsAsync(refresh: true);
        }
        catch (Exception ex)
        {
            Toasts.Show(ex.Message, isError: true);
        }
        finally
        {
            isSaving = false;
        }
    }
}
