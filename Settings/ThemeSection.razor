@namespace Nxt.UI.Settings
@inject ThemeService Theme
@inject NxtText L

<NxtSettingsSection Icon="🌓" Title="@L["theme_title"]" Description="@L["theme_desc"]">
    <NxtSegmented TValue="string" Label="@L["theme_title"]" Value="@mode" ValueChanged="SetAsync"
                  Options="@([("system", L["theme_system"]), ("light", L["theme_light"]), ("dark", L["theme_dark"])])" />
</NxtSettingsSection>

@code {
    private string mode = "system";

    protected override async Task OnInitializedAsync() => mode = await Theme.GetAsync();

    private async Task SetAsync(string value)
    {
        mode = value;
        await Theme.SetAsync(value);
    }
}
